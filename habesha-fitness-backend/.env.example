# --- Server ---
PORT=4000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --- PostgreSQL database ---
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/habesha_fitness
DATABASE_SSL=false

# --- First administrator ---
ADMIN_EMAIL=admin@habesha.demo
ADMIN_PASSWORD=Admin1234
ADMIN_NAME=Aklilu Tesfay

# --- AI chat (optional) ---
# AI_SCOPE: "general" answers any topic with live web search; "gym" restricts to gym-only questions.
AI_SCOPE=general
# AI_WEB_SEARCH: set true to enable live web search grounding (Gemini / Anthropic)
AI_WEB_SEARCH=false
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=
AI_RATE_LIMIT_PER_HOUR=20

# Example using Google Gemini with live web search:
# AI_PROVIDER=gemini
# AI_MODEL=gemini-2.5-flash
# AI_API_KEY=your_gemini_api_key
# AI_WEB_SEARCH=true
